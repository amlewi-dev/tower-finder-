{
  "expo": {
    "name": "Tower Finder",
    "slug": "tower-finder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090b",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.towerfinder.app"
    },
    "android": {
      "package": "com.towerfinder.app",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tower Finder uses your location to find the nearest cell towers and to place tower submissions."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Tower Finder uses the camera so you can photograph a tower you are submitting."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "30745bc8-efab-440c-9650-f7cc8491638a"
      }
    }
  }
}
